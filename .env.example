# Copie para .env (nunca versione nem envie o arquivo com segredos).
# O .env é lido automaticamente por run_bridge.py, run_panel.py e
# python -m storage.cli. Variáveis explícitas do sistema têm prioridade.
#
# SQLite é a fonte única de dados operacionais; este arquivo só define
# INFRAESTRUTURA (não GPIO, PID, receitas, sensores ou tópicos MQTT).

# Caminho relativo à raiz desta instalação, mesmo iniciando em outro diretório.
# Depois de importar os dados da main, indique imported.sqlite3.
# Para instalação vazia, use bridge.sqlite3 e execute: python -m storage.cli init
TESSERACT_BRIDGE_DB=./data/private/imported.sqlite3

# 1 = ignora backend real no banco, desliga cliente MQTT e usa porta de testes.
# 0 = segue backend/MQTT aprovados no banco; use somente após homologação.
TESSERACT_BRIDGE_SIMULATION_ONLY=1

# Porta utilizada somente com SIMULATION_ONLY=1, escutando em 127.0.0.1.
TESSERACT_BRIDGE_TEST_PANEL_PORT=8089

# Overrides de infraestrutura somente no modo normal (SIMULATION_ONLY=0).
# Se vazios, host/porta aprovados no SQLite continuam valendo.
TESSERACT_BRIDGE_PANEL_HOST=
TESSERACT_BRIDGE_PANEL_PORT=

# Necessário para o editor SQLite em Gerenciamento.
# Gere um valor exclusivo com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use >=16 caracteres; não publique este valor no GitHub.
TESSERACT_BRIDGE_ADMIN_TOKEN=
