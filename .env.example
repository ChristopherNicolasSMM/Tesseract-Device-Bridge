# Referência de infraestrutura. Para instalação nova, use python -m setup:
# ele cria ORM e .env sem precisar copiar este arquivo ou inicializar banco antes.
# Não copie valores reais de credenciais para o Git.
# Variáveis já definidas no shell/serviço prevalecem sobre .env.

# Caminho relativo à raiz do clone novo, não ao diretório do terminal.
TESSERACT_BRIDGE_DB=./data/private/bridge.sqlite3
TESSERACT_BRIDGE_STORAGE_MODE=orm
TESSERACT_BRIDGE_SIMULATION_ONLY=1
TESSERACT_BRIDGE_TEST_PANEL_PORT=8089
TESSERACT_BRIDGE_PANEL_HOST=127.0.0.1
TESSERACT_BRIDGE_PANEL_PORT=8088

# O setup permite gerar token, usar valor personalizado ou política local explícita.
# ADMIN_TOKEN textual continua suportado. ADMIN_TOKEN_B64 não vazio tem prioridade.
# Base64 não é criptografia. Nunca publique o valor real.
TESSERACT_BRIDGE_ADMIN_TOKEN=
TESSERACT_BRIDGE_ADMIN_TOKEN_B64=
# 1 somente quando escolheu explicitamente administração local sem token.
# Sem token e com 0, a administração fica desativada.
TESSERACT_BRIDGE_LOCAL_ADMIN=0

# Identificador real gerado apenas na publicação; não invente UUID para liberar runtime.
TESSERACT_BRIDGE_INSTALL_ID=

# Compatibilidade avançada: bancos SQLite anteriores podem usar STORAGE_MODE=legacy.
# Não use storage.cli init para criar a nova instalação ORM: use o assistente.
# O modo configurado exige setup concluído e mantém intertravamentos e Python 3.9
# para GPIO real. Consulte docs/manual/20-instalacao-migracao-2.0.0.md.
