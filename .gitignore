__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
*.log
.env
*.patch

# data/private/ é onde a diferença entre public e private vira real:
# tudo aqui dentro NUNCA vai commitado (exceto o .gitkeep, que mantém
# a pasta existindo em qualquer clone novo do repositório).
data/private/*
!data/private/.gitkeep

# Qual receita fica ativa no próximo boot é escolha de operação local
# ("o que eu vou brassar agora"), não configuração do projeto.
data/active_recipe.txt