mqtt:
  enabled: false              # false = roda só em modo painel manual, sem cliente MQTT nenhum | true ai roda com MQTT
  host: localhost
  port: 1883
  username: null
  password: null
  client_id: tesseract_bridge_01
  topic_prefix: brewery
  reconnect_interval_seconds: 5

backend: simulated            # "real" ou "simulated" — nunca autodetectado

panel:
  enabled: true
  host: 0.0.0.0
  port: 8088

# Mapeamento de GPIO conforme a Interface CraftBeerPi (MAZZA Handmade):
# https://www.mazzahandmade.com.br/produtos/interface-clp-para-raspberrypi-automacao-cervejeira-craftbeerpi-brewpi1/
#
# Saídas usadas (de 13 disponíveis, NPN 12V 500mA — liga/desliga digital,
# não é PWM de hardware): GPIO17, GPIO27, GPIO22, GPIO26. GPIO13 livre
# para expansão futura (ex.: solenoide de chiller).
#
# Os 3 sensores DS18B20 compartilham o mesmo barramento 1-Wire (GPIO4,
# bornes "SENSOR 1/2/3" em paralelo na placa) — cada um é identificado
# pelo seu endereço ROM único, não pelo pino. Descubra os endereços
# conectados rodando: python -m gpio.ds18b20_scan
#
# O GPIO escolhido para cada device é só convenção deste arquivo — pode
# trocar livremente, desde que bata com o que foi fisicamente cabeado.

devices:
  - id: mash_tun_temp
    name: "Temperatura Mostura"
    role: sensor
    subtype: temperature
    unit: "°C"
    state_topic: "sensors/mash_tun_temp/state"
    hardware:
      pin: 4
      driver: ds18b20
      address: "28-0000071234ab"   # substituir pelo endereço real (ver gpio/ds18b20_scan.py)
    simulated:
      initial_value: 25.0
      min: 0
      max: 120

  - id: boil_temp
    name: "Temperatura Fervura"
    role: sensor
    subtype: temperature
    unit: "°C"
    state_topic: "sensors/boil_temp/state"
    hardware:
      pin: 4
      driver: ds18b20
      address: "28-0000071234cd"   # substituir pelo endereço real
    simulated:
      initial_value: 20.0
      min: 0
      max: 120

  - id: chiller_out_temp
    name: "Temperatura Saída Chiller"
    role: sensor
    subtype: temperature
    unit: "°C"
    state_topic: "sensors/chiller_out_temp/state"
    hardware:
      pin: 4
      driver: ds18b20
      address: "28-0000071234ef"   # substituir pelo endereço real
    simulated:
      initial_value: 18.0
      min: 0
      max: 100

  - id: mash_heater
    name: "Resistência Caldeira Mostura"
    role: actuator
    subtype: digital              # liga/desliga — potência via time-proportioning (ver hardware.window_seconds), não PWM de hardware
    command_topic: "actuators/mash_heater/set"
    state_topic: "actuators/mash_heater/state"
    hardware:
      pin: 17
      # active_high: true   # MAZZA NPN: HIGH = liga (default, pode omitir)
      #                     # Use false apenas para relés active-low (módulos
      #                     # azuis do AliExpress com optoacoplador invertido)
      window_seconds: 10    # ativa controle de potência (0-100%) via DeviceRuntime —
                             # slider no painel + override manual + duty de receita,
                             # com prioridade failsafe > manual > receita > repouso.
                             # Obrigatório se este device for usado como heater_device_id
                             # de uma vessel em recipe.yml.
    failsafe_value: false
    is_risk: true
    failsafe_timeout_seconds: 30

  - id: boil_heater
    name: "Resistência Caldeira Fervura"
    role: actuator
    subtype: digital
    command_topic: "actuators/boil_heater/set"
    state_topic: "actuators/boil_heater/state"
    hardware:
      pin: 27
      # active_high: true   # MAZZA NPN: HIGH = liga (default, pode omitir)
      window_seconds: 10
    failsafe_value: false
    is_risk: true
    failsafe_timeout_seconds: 30

  - id: pump_b1
    name: "Bomba B1 (Mostura)"
    role: actuator
    subtype: digital
    command_topic: "actuators/pump_b1/set"
    hardware:
      pin: 22
      # active_high: true   # MAZZA NPN: HIGH = liga (default, pode omitir)
    failsafe_value: false
    is_risk: true
    failsafe_timeout_seconds: 30

  - id: pump_b2
    name: "Bomba B2 (Fervura + Whirlpool + Chiller)"
    role: actuator
    subtype: digital
    command_topic: "actuators/pump_b2/set"
    hardware:
      pin: 26
      # active_high: true   # MAZZA NPN: HIGH = liga (default, pode omitir)
    failsafe_value: false
    is_risk: true
    failsafe_timeout_seconds: 30
