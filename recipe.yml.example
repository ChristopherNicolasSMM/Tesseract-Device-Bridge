# Exemplo de receita autônoma — não depende de MQTT/Tesseract para
# rodar. Referência de schema: a receita "de fábrica" já vem migrada
# em data/publico/receita_base.yaml (edite ela direto — é a única
# receita que não passa pelo sistema de cadastro em data/, mas
# continua selecionável normalmente pra brassar). Este arquivo aqui é
# só documentação de formato — não é mais copiado/carregado automaticamente.
#
# Schema de `vessels` espelha devices.yml: lista de itens com `id`
# (referência estável, usada por steps.vessel) + `name` (texto livre
# de exibição) + `order` (opcional — sem ele, usa a ordem de
# declaração na lista).
#
# Referências de device_id (heater_device_id, sensor_device_id, pumps)
# precisam existir no devices.yml carregado — validado no boot.
#
# A janela de time-proportioning (antigo campo `window_seconds` aqui)
# agora é declarada em hardware.window_seconds no devices.yml do
# heater_device_id — cada actuator com controle de potência tem UM
# window_seconds só, compartilhado entre receita, override manual e
# painel, evitando duas fontes de verdade divergentes.


name: "Lagers da Casa"

vessels:
  - id: mash
    name: "Mash"
    order: 0
    heater_device_id: mash_heater
    sensor_device_id: mash_tun_temp
    pid:
      kp: 5.0
      ki: 0.1
      kd: 0.0

  - id: boil
    name: "Boil"
    order: 1
    heater_device_id: boil_heater
    sensor_device_id: boil_temp
    pid:
      kp: 4.0
      ki: 0.05
      kd: 0.0

steps:
  - vessel: mash
    label: "Mostura - Beta-Amilase"
    target_temp: 67
    hold_minutes: 40
    pumps: [pump_b1]   # recirculação durante a mostura

  - vessel: mash
    label: "Mostura - Alfa-Amilase"
    target_temp: 67
    hold_minutes: 20
    pumps: [pump_b1]   # recirculação durante a mostura

  - vessel: mash
    label: "Mostura - Mash Out"
    target_temp: 75
    hold_minutes: 15
    pumps: [pump_b1]   # recirculação durante a mostura

  - vessel: boil
    label: "Fervura"
    target_temp: 100
    hold_minutes: 60
    pumps: [pump_b2]   # whirlpool/chiller na fervura
    # Alarmes de lupulagem (opcional) -- minutes_remaining conta pra
    # TRÁS, a partir do fim do patamar (convenção cervejeira: "60min"
    # = faltam 60min pro fim da fervura, não 60min desde o início).    
    hop_alarms:
          - minutes_remaining: 60   # alerta quando faltam 60min para o fim da fervura
            label: "Lúpulo Amargor - 30g Magnum"
          - minutes_remaining: 55   
            label: "Lúpulo Amargor - 10g Magnum"
          - minutes_remaining: 50   
            label: "Lúpulo Amargor - 15g Magnum"   
          - minutes_remaining: 01   
            label: "Whirpool - 10min" 
            
